default_platform(:ios)

TEAM_ID = ENV["APPLE_TEAM_ID"].to_s.empty? ? "G3793W2RJ2" : ENV["APPLE_TEAM_ID"]
APP_ID = "com.klaviyo.FlutterExample"
EXT_ID = "com.klaviyo.FlutterExample.NotificationServiceExtension"
PROJECT = File.expand_path("../Runner.xcodeproj", __dir__)
EXAMPLE = File.expand_path("../..", __dir__)

def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
    is_key_content_base64: true,
    in_house: false
  )
end

def export_env(name, value)
  return unless ENV["GITHUB_ENV"]

  File.open(ENV["GITHUB_ENV"], "a") { |f| f.puts "#{name}=#{value}" }
end

ROOT = File.expand_path("../../..", __dir__)

def derive_app_version(build_number)
  version = sh("'#{ROOT}/.github/scripts/app-version.sh' '#{ENV.fetch('SDK_VERSION')}' '#{build_number}'", log: false).strip
  ENV["APP_VERSION"] = version
  export_env("APP_VERSION", version)
  version
end

# match runs read-only against klaviyo/mobile-certificates (shared App Store
# distribution identity + profiles); it never creates certificates.
platform :ios do
  desc "Install the App Store distribution identity + profiles and pin each target to them"
  lane :install_signing do
    setup_ci

    match(type: "appstore", readonly: true)

    # macOS 26's `security import` rejects the empty-password .p12 that match
    # imports, so bring the private key in from a password-protected .p12.
    import_certificate(
      certificate_path: ENV.fetch("CERT_P12_PATH"),
      certificate_password: ENV.fetch("P12_PASSWORD"),
      keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain"),
      keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")
    )

    [
      { targets: ["Runner"], profile: "match AppStore #{APP_ID}" },
      { targets: ["NotificationServiceExtension"], profile: "match AppStore #{EXT_ID}" },
    ].each do |cfg|
      update_code_signing_settings(
        path: PROJECT,
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        targets: cfg[:targets],
        profile_name: cfg[:profile],
        build_configurations: ["Release"]
      )
    end

    # The Flutter template pins CODE_SIGN_IDENTITY[sdk=iphoneos*] to "iPhone Developer".
    pbxproj = File.join(PROJECT, "project.pbxproj")
    content = File.read(pbxproj)
    content.gsub!(/("CODE_SIGN_IDENTITY\[sdk=iphoneos\*\]" = )"[^"]*"/, '\1"Apple Distribution"')
    File.write(pbxproj, content)
  end

  # Expects `flutter build ios --release --config-only` to have run first so
  # Pods are in place; it runs again here so Generated.xcconfig carries the
  # real build number and derived version.
  desc "Archive + export a signed IPA to example/build/ios/ipa/Runner.ipa"
  lane :build_ipa do |options|
    build_number = options.fetch(:build_number).to_s
    UI.user_error!("build_number must be numeric") unless build_number.match?(/\A\d+\z/)
    app_version = derive_app_version(build_number)

    Bundler.with_unbundled_env do
      sh("cd '#{EXAMPLE}' && flutter build ios --release --config-only --no-codesign " \
         "--build-name='#{ENV.fetch('IOS_MARKETING_VERSION')}' --build-number=#{build_number} " \
         "--dart-define-from-file=build-info.json --dart-define=derivedAppVersion='#{app_version}'")
    end

    build_app(
      workspace: File.expand_path("../Runner.xcworkspace", __dir__),
      scheme: "Runner",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      # The extension hardcodes CURRENT_PROJECT_VERSION = 1; App Store Connect
      # wants it to match the host app's CFBundleVersion.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} FLUTTER_BUILD_NUMBER=#{build_number} KLAVIYO_APP_VERSION='#{app_version}'",
      clean: false,
      output_directory: File.expand_path("../../build/ios/ipa", __dir__),
      output_name: "Runner.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_ID => "match AppStore #{APP_ID}",
          EXT_ID => "match AppStore #{EXT_ID}",
        },
      }
    )
  end

  desc "Print and export (BUILD_NUMBER, ASC_APP_ID) the next TestFlight build number for a marketing version"
  lane :next_build_number do |options|
    version = options.fetch(:version)
    latest = latest_testflight_build_number(
      version: version,
      app_identifier: APP_ID,
      api_key: asc_key,
      initial_build_number: 0
    )
    number = latest.to_i + 1
    export_env("BUILD_NUMBER", number)
    export_env("ASC_APP_ID", Spaceship::ConnectAPI::App.find(APP_ID).id)
    UI.message("Next build number for #{version}: #{number}")
    number
  end

  desc "Build and upload to TestFlight, retrying once with a fresh build number"
  lane :release do |options|
    version = options.fetch(:version)
    expected = ENV["IOS_MARKETING_VERSION"].to_s
    UI.user_error!("version '#{version}' does not match IOS_MARKETING_VERSION '#{expected}'") unless version == expected
    number = next_build_number(version: version)
    built = nil
    attempts = 0
    begin
      attempts += 1
      unless built == number
        build_ipa(build_number: number)
        built = number
      end
      upload_to_testflight(
        api_key: asc_key,
        app_identifier: APP_ID,
        ipa: File.expand_path("../../build/ios/ipa/Runner.ipa", __dir__),
        skip_waiting_for_build_processing: true
      )
    rescue StandardError => e
      raise if attempts >= 2

      UI.important("Upload failed (#{e.message}); retrying once")
      number = next_build_number(version: version)
      retry
    end
  end

  desc "Set the TestFlight What to Test text once the build has finished processing"
  lane :whats_new do |options|
    upload_to_testflight(
      api_key: asc_key,
      app_identifier: APP_ID,
      app_platform: "ios",
      app_version: options.fetch(:version),
      build_number: options.fetch(:build_number).to_s,
      changelog: File.read(options.fetch(:notes_file)),
      distribute_only: true,
      skip_submission: true,
      wait_processing_timeout_duration: 1800
    )
  end
end
